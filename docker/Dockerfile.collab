FROM node:22-bookworm-slim
WORKDIR /app
RUN apt-get update && apt-get install -y python3 make g++ libsqlite3-0 && rm -rf /var/lib/apt/lists/*
COPY collab/package.json ./
RUN npm install --omit=dev
COPY collab/ ./
RUN mkdir -p /data
ENV DATA_DIR=/data
ENV HOCUSPOCUS_PORT=1234
EXPOSE 1234
CMD ["npx", "tsx", "src/server.ts"]
