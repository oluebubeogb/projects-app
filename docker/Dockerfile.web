FROM node:22-bookworm-slim AS builder
WORKDIR /app

RUN apt-get update && apt-get install -y \
    python3 make g++ \
    && rm -rf /var/lib/apt/lists/*

COPY web/package.json web/package-lock.json* ./
RUN npm install

COPY web/ ./
RUN mkdir -p public

# NEXT_PUBLIC_* vars are inlined at build time — must be provided as build args
ARG NEXT_PUBLIC_HOCUSPOCUS_URL=wss://ws.project.collab.name.ng
ARG NEXT_PUBLIC_APP_URL=https://project.collab.name.ng

ENV NEXT_PUBLIC_HOCUSPOCUS_URL=$NEXT_PUBLIC_HOCUSPOCUS_URL
ENV NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production

RUN echo "=== Building with ===" && \
    echo "NEXT_PUBLIC_HOCUSPOCUS_URL=$NEXT_PUBLIC_HOCUSPOCUS_URL" && \
    echo "NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL" && \
    npm run build 2>&1 || (echo "===== NEXT BUILD FAILED =====" && exit 1)

FROM node:22-bookworm-slim AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

RUN apt-get update && apt-get install -y \
    libsqlite3-0 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/public ./public
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static

# Native modules used by the server at runtime
COPY --from=builder /app/node_modules/better-sqlite3 ./node_modules/better-sqlite3
COPY --from=builder /app/node_modules/bindings ./node_modules/bindings
COPY --from=builder /app/node_modules/file-uri-to-path ./node_modules/file-uri-to-path

RUN mkdir -p /data
ENV DATA_DIR=/data

EXPOSE 3000
CMD ["node", "server.js"]