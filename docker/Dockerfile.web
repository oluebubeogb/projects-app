FROM node:22-bookworm-slim AS builder
WORKDIR /app

RUN apt-get update && apt-get install -y \
    python3 make g++ \
    && rm -rf /var/lib/apt/lists/*

COPY web/package.json web/package-lock.json* ./
RUN npm install --no-audit --no-fund

COPY web/ ./
RUN mkdir -p public

ARG NEXT_PUBLIC_HOCUSPOCUS_URL=
ARG NEXT_PUBLIC_APP_URL=

ENV NEXT_PUBLIC_HOCUSPOCUS_URL=$NEXT_PUBLIC_HOCUSPOCUS_URL
ENV NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production
# Do not require a live DB during build
ENV DATABASE_URL=postgres://build:build@127.0.0.1:1/build

RUN echo "=== BUILD ENV ==="
RUN echo "NEXT_PUBLIC_HOCUSPOCUS_URL=${NEXT_PUBLIC_HOCUSPOCUS_URL:-'(same-origin)'}"
RUN echo "NEXT_PUBLIC_APP_URL=${NEXT_PUBLIC_APP_URL:-'(same-origin)'}"

# Surface full TypeScript / Next errors in Coolify logs
RUN npm run build 2>&1

FROM node:22-bookworm-slim AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/public ./public
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static

# Optional: migrate helper (idempotent). Needs DATABASE_URL at runtime.
COPY --from=builder /app/src/lib/db/migrate.ts ./migrate.ts
COPY --from=builder /app/node_modules/postgres ./node_modules/postgres
COPY --from=builder /app/node_modules/drizzle-orm ./node_modules/drizzle-orm
COPY --from=builder /app/node_modules/tsx ./node_modules/tsx
COPY --from=builder /app/node_modules/esbuild ./node_modules/esbuild 2>/dev/null || true
COPY --from=builder /app/node_modules/get-tsconfig ./node_modules/get-tsconfig 2>/dev/null || true
COPY --from=builder /app/node_modules/resolve-pkg-maps ./node_modules/resolve-pkg-maps 2>/dev/null || true

RUN mkdir -p /data
ENV DATA_DIR=/data

EXPOSE 3000

CMD ["sh", "-c", "npx tsx migrate.ts 2>/dev/null || true; node server.js"]
