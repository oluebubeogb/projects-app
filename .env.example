JWT_SECRET=change-me-to-a-long-random-string

# PostgreSQL (must match docker-compose defaults or your override)
POSTGRES_USER=projects
POSTGRES_PASSWORD=projects
POSTGRES_DB=projects

# Used by the Node apps on your host machine (migrate, next dev, etc.)
# Host = localhost because ports are published. Inside Docker the hostname is "postgres".
DATABASE_URL=postgres://projects:projects@localhost:5432/projects

# Redis
REDIS_URL=redis://localhost:6379

# Uploads / media
DATA_DIR=./web/data

HOCUSPOCUS_PORT=1235

# Local development (set these so the browser talks to local collab)
NEXT_PUBLIC_HOCUSPOCUS_URL=ws://localhost:1235
NEXT_PUBLIC_APP_URL=http://localhost:3000
