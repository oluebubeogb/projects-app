JWT_SECRET=change-me-to-a-long-random-string
DATA_DIR=./web/data
HOCUSPOCUS_PORT=1235

# Local development
# NEXT_PUBLIC_HOCUSPOCUS_URL=ws://localhost:1235
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Production (Coolify) — these are baked into the client at BUILD time.
# Set them as build args / environment variables BEFORE building the image.
NEXT_PUBLIC_HOCUSPOCUS_URL=wss://ws.project.collab.name.ng
NEXT_PUBLIC_APP_URL=https://project.collab.name.ng
