JWT_SECRET=change-me-to-a-long-random-string

# PostgreSQL
POSTGRES_USER=projects
POSTGRES_PASSWORD=projects
POSTGRES_DB=projects
DATABASE_URL=postgres://projects:projects@localhost:5432/projects

# Redis (Hocuspocus / real-time)
REDIS_URL=redis://localhost:6379

# Uploads / media
DATA_DIR=./web/data

HOCUSPOCUS_PORT=1235

# Local development
# NEXT_PUBLIC_HOCUSPOCUS_URL=ws://localhost:1235
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Production (Coolify) — same-origin recommended
# Leave both empty so the client uses window.location + /collab path
NEXT_PUBLIC_HOCUSPOCUS_URL=
NEXT_PUBLIC_APP_URL=
