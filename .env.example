JWT_SECRET=change-me-to-a-long-random-string
DATA_DIR=./web/data

# PostgreSQL
DATABASE_URL=postgresql://projects:projects@localhost:5433/projects
POSTGRES_USER=projects
POSTGRES_PASSWORD=projects
POSTGRES_DB=projects

# Redis (Hocuspocus multi-instance / pubsub)
REDIS_URL=redis://localhost:6380

HOCUSPOCUS_PORT=1236

# Local development
# NEXT_PUBLIC_HOCUSPOCUS_URL=ws://localhost:1236
# NEXT_PUBLIC_APP_URL=http://localhost:3010

# Production (Coolify) — same-origin recommended
NEXT_PUBLIC_HOCUSPOCUS_URL=
NEXT_PUBLIC_APP_URL=

# Demo / placeholder content (optional)
# SEED_DEMO=1          → auto-insert 5 users, 10 projects, 4 forums, DMs on startup
# CLEAR_DEMO=1         → wipe only demo rows (by id prefix demo-*) then optionally re-seed
# Login: each account password = its email
#   e.g. c2@mova.cms  /  c2@mova.cms
# SEED_DEMO=1
# CLEAR_DEMO=1
